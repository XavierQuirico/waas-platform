{
  "name": "waas-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && next-sitemap",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/clean-next.js && playwright test",
    "test:e2e:full": "cross-env RUN_AUTH_E2E_FULL=1 playwright test tests/e2e/catalog-commercial.spec.ts --project=admin --project=cliente",
    "test:e2e:full:prod": "cross-env RUN_AUTH_E2E_FULL=1 PLAYWRIGHT_REUSE_SERVER=1 playwright test",
    "test:e2e:full:prod:clean": "tsx scripts/run-e2e-full-prod.ts",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed-demo.ts",
    "seed:clean": "tsx scripts/seed-demo.ts --clean",
    "seed:catalog": "tsx scripts/seed-catalog-defaults.ts",
    "seed:e2e-auth": "tsx scripts/seed-e2e-auth-fixture.ts",
    "build:clean": "node -e \"require('fs').rmSync('.next', {recursive: true, force: true})\" && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@clerk/backend": "^3.2.2",
    "@clerk/nextjs": "^6.0.0",
    "@hookform/resolvers": "^3.9.0",
    "@neondatabase/serverless": "^0.9.0",
    "@paypal/react-paypal-js": "^8.7.0",
    "@react-email/components": "^0.0.22",
    "@react-email/render": "^0.0.17",
    "@sentry/nextjs": "^10.45.0",
    "@trpc/server": "^11.0.0",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "gsap": "^3.14.2",
    "inngest": "^3.0.0",
    "lucide-react": "^1.8.0",
    "next": "^15.0.0",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.0",
    "resend": "^4.0.0",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@clerk/testing": "^1.14.6",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.1",
    "autoprefixer": "^10.4.27",
    "cross-env": "^7.0.3",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "jsdom": "^29.0.1",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.1"
  },
  "description": "Website-as-a-Service platform: public intake wizard, client portal, admin console, PayPal billing and automated workflows.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.9.0"
  }
}
