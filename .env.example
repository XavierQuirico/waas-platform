# ─────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. Never commit real values.
# "required" = the app does not work without it.
# ─────────────────────────────────────────────────────────────

# ── Database (Neon Postgres) ── required
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Authentication (Clerk) ── required
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/acceder
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/acceder
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/acceder/resolver
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/acceder/resolver

# Clerk user id of the administrator (the `admins` table is also honored).
ADMIN_CLERK_USER_ID=user_...
# Where internal notifications are sent.
ADMIN_EMAIL=admin@example.com

# ── App URL ── required
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Email (Resend) ──
RESEND_API_KEY=re_...
# Sender and reply-to for every email. Defaults shown.
EMAIL_FROM="QUIRICO STUDIOS <hola@quiricostudios.com>"
EMAIL_REPLY_TO=hola@quiricostudios.com
# Set to "true" to skip real sending (demo and test environments).
EMAIL_DRY_RUN=false

# ── Payments (PayPal) ──
# Use "sandbox" everywhere except production.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_WEBHOOK_ID=
# Subscription plan ids (created once with POST /api/paypal/setup-plans).
PAYPAL_PLAN_ID_BASIC=
PAYPAL_PLAN_ID_PRO=
PAYPAL_PLAN_ID_BUSINESS=
# Protects POST /api/paypal/setup-plans together with an admin session.
ADMIN_SETUP_SECRET=

# ── File storage (Cloudflare R2, S3-compatible) ──
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ── Background jobs (Inngest) ── required in production
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Webhooks ──
# Shared secret for the uptime monitor webhook. Add it to the alert contact URL as ?secret=...
UPTIMEROBOT_WEBHOOK_SECRET=

# ── AI features (optional; deterministic fallbacks are used when unset) ──
GROQ_API_KEY=

# ── SEO reports (optional) ──
GOOGLE_PAGESPEED_API_KEY=

# ── Observability (optional) ──
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Public contact details (optional, safe defaults are used) ──
NEXT_PUBLIC_CONTACT_WHATSAPP=18095550100
NEXT_PUBLIC_CONTACT_EMAIL=hola@quiricostudios.com

# ── Hosts (optional) ──
# Production serves the public site, portal and admin from separate subdomains and the
# middleware redirects between them. Override the origins here, or set
# NEXT_PUBLIC_SINGLE_HOST=true to serve everything from one host (demos, previews).
NEXT_PUBLIC_SINGLE_HOST=false
PORTAL_ORIGIN=
ADMIN_ORIGIN=
PUBLIC_ORIGIN=

# ── Security headers (optional) ──
# Extra origins allowed by the Content-Security-Policy, comma separated.
# The Clerk frontend host is derived automatically from the publishable key.
CSP_EXTRA_ORIGINS=

# ── End-to-end tests (only needed to run `npm run test:e2e:full`) ──
TEST_ADMIN_EMAIL=
TEST_CLIENT_EMAIL=
QA_ADMIN_CLERK_USER_ID=
QA_CLIENT_CLERK_USER_ID=
